class Data {
    private int value;
    private boolean available = false;

    synchronized void produce(int value) {
        while (available) {
            try {
                wait();
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }

        this.value = value;
        available = true;
        System.out.println("Producer produced: " + value);

        notifyAll();
    }

    synchronized int consume(String consumerName) {
        while (!available) {
            try {
                wait();
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }

        int data = value;
        available = false;
        System.out.println(consumerName + " consumed: " + data);

        notifyAll();
        return data;
    }
}

class Producer extends Thread {
    private Data data;

    Producer(Data data) {
        this.data = data;
    }

    public void run() {
        for (int i = 1; i <= 5; i++) {
            data.produce(i);

            try {
                Thread.sleep(100);
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }
}

class Consumer extends Thread {
    private Data data;
    private String consumerName;

    Consumer(Data data, String consumerName) {
        this.data = data;
        this.consumerName = consumerName;
    }

    public void run() {
        for (int i = 1; i <= 5; i++) {
            data.consume(consumerName);
        }
    }
}

public class InterThreadCommunication {
    public static void main(String[] args) {

        Data data = new Data();

        Producer producer = new Producer(data);

        Consumer consumer1 = new Consumer(data, "Consumer 1");
        Consumer consumer2 = new Consumer(data, "Consumer 2");

        producer.start();
        consumer1.start();
        consumer2.start();

        try {
            producer.join();
            consumer1.join();
            consumer2.join();
        } catch (InterruptedException e) {
            System.out.println(e);
        }

        System.out.println("All threads completed.");
    }
}
