import java.io.*;
import java.util.*;

class InvalidEmployeeException extends Exception {
    InvalidEmployeeException(String msg) {
        super(msg);
    }
}

abstract class Person {
    String name;
    int age;

    Person(String n, int a) {
        name = n;
        age = a;
    }
}

class Employee extends Person {
    int id;
    String dept;
    double salary;

    Employee(int i, String n, int a, String d, double s) {
        super(n, a);
        id = i;
        dept = d;
        salary = s;
    }

    public String toString() {
        return id + " " + name + " " + age + " " + dept + " " + salary;
    }
}

class EmployeeRepository {
    Map<Integer, Employee> map = new LinkedHashMap<>();

    void add(Employee e) throws InvalidEmployeeException {
        if (e.name.isBlank() || e.age < 18 || e.age > 60 || e.salary <= 0)
            throw new InvalidEmployeeException("Invalid employee data");
        if (map.containsKey(e.id))
            throw new InvalidEmployeeException("Duplicate ID");
        map.put(e.id, e);
    }
}

public class EmployeeManagementApp {
    public static void main(String[] args) {
        EmployeeRepository r = new EmployeeRepository();

        Employee[] employees = {
            new Employee(1, "Anand", 28, "IT", 62000),
            new Employee(2, "Bhavana", 32, "HR", 45000),
            new Employee(3, "Charan", 15, "Finance", 30000),
            new Employee(2, "Deepika", 30, "IT", 70000)
        };

        for (Employee e : employees) {
            try {
                r.add(e);
                System.out.println("Added: " + e.name);
            } catch (InvalidEmployeeException ex) {
                System.out.println("Rejected: " + ex.getMessage());
            }
        }

        try (BufferedWriter w = new BufferedWriter(
                new FileWriter("employees.txt"))) {
            for (Employee e : r.map.values()) {
                w.write(e.toString());
                w.newLine();
            }
            System.out.println("Records saved successfully");

        } catch (IOException e) {
            System.out.println("File error");
        }

        try (BufferedReader b = new BufferedReader(
                new FileReader("employees.txt"))) {
            String line;
            while ((line = b.readLine()) != null)
                System.out.println(line);
        } catch (IOException e) {
            System.out.println("File error");
        }
    }
}
